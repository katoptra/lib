# op:// references only; `op run --env-file=op.env` resolves them at run time.
MIRROR_PROTON_DESTINATION=op://VAULT/proton/destination
MIRROR_PROTON_DESTINATION_UID=op://VAULT/proton/destination_uid
AWS_ACCESS_KEY_ID=op://VAULT/r2/access_key_id
AWS_SECRET_ACCESS_KEY=op://VAULT/r2/secret_access_key
AWS_ENDPOINT_URL_S3=op://VAULT/r2/endpoint
MIRROR_R2_BUCKET=op://VAULT/r2/bucket
MIRROR_AGE_IDENTITY=op://VAULT/age/identity
HEALTHCHECK_URL=op://VAULT/healthcheck/url
