# This file contains only op:// references. `op run --env-file=op.env` gets their values
# at run time. The secrets are in one vault, addressed by UUID. Thus, the references stay
# correct when the vault gets a new name. The item is example. Refer to katoptra/lib, Secrets.
MIRROR_PROTON_DESTINATION=op://<vault-uuid>/example/proton/destination
MIRROR_PROTON_DESTINATION_UID=op://<vault-uuid>/example/proton/destination_uid
AWS_ACCESS_KEY_ID=op://<vault-uuid>/example/r2/access_key_id
AWS_SECRET_ACCESS_KEY=op://<vault-uuid>/example/r2/secret_access_key
AWS_ENDPOINT_URL_S3=op://<vault-uuid>/example/r2/endpoint
MIRROR_R2_BUCKET=op://<vault-uuid>/example/r2/bucket
MIRROR_AGE_IDENTITY=op://<vault-uuid>/example/age/identity
HEALTHCHECK_URL=op://<vault-uuid>/example/healthcheck/url
