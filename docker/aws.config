# This file is the configuration of the AWS CLI in the rsync image. The Dockerfile puts
# this file at /etc/aws.config and sets AWS_CONFIG_FILE to that path. Thus, each aws
# command reads it.
#
# The default multipart threshold of the CLI is 8 MB, and here it is 4 GiB. Thus, a file
# of less than 4 GiB goes to the bucket as one PutObject. R2 rejects one part of more than
# 4.995 GiB. Thus, a file of more than 4 GiB goes to the bucket in parts of 512 MiB. Five
# CTAN files are more than 4.995 GiB, and each goes in 13 parts, for 15 Class A
# operations. The largest gnu file is 1.51 GB, the largest nongnu file is 0.72 GB, and the
# largest tlnet file is approximately 145 MB.
#
# R2 can give a 503 when the CLI writes many objects in a short time. The standard retry
# mode waits and tries again, for a maximum of ten attempts.
[default]
retry_mode = standard
max_attempts = 10
s3 =
    multipart_threshold = 4GB
    multipart_chunksize = 512MB
    max_concurrent_requests = 32
