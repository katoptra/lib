# This file configures the AWS CLI in the rsync image. The image copies it to
# /etc/aws.config and sets AWS_CONFIG_FILE to that path, so every aws call reads it.
#
# The CLI's default multipart threshold is 8 MB. Here it is 4 GiB, so a file under 4 GiB
# goes up as one PutObject. R2 refuses a single part over 4.995 GiB. So a file over
# 4 GiB goes up in 512 MiB parts. Five CTAN files are over 4.995 GiB, and each goes up in
# 13 parts, for 15 Class A operations. The largest gnu file is 1.51 GB, the largest
# nongnu file is 0.72 GB, and the largest tlnet file is about 145 MB.
#
# R2 answers a burst of writes with a 503 at times. The standard retry mode waits and
# tries again, for up to ten attempts.
[default]
retry_mode = standard
max_attempts = 10
s3 =
    multipart_threshold = 4GB
    multipart_chunksize = 512MB
    max_concurrent_requests = 32
